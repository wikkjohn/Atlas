{
  "workflow_id": "WF-1029",
  "name": "Periodic KYC Review",
  "version": 1,
  "description": "A verified customer's periodic KYC review (due every year when rated high risk, two when medium, three when low) is opened if none is due, and a compliance officer other than the initiator (compliance:monitor) approves its outcome: the customer's risk rating confirmed, raised or lowered. The next review falls due by the new rating. Stored definition: built only from library handlers (Phase 45).",
  "business_owner": "Financial Crime Compliance",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "customer_number",
      "risk_rating"
    ],
    "properties": {
      "customer_number": {
        "type": "string",
        "pattern": "^CUS-[0-9]{7,}$"
      },
      "risk_rating": {
        "type": "string",
        "enum": [
          "high",
          "low",
          "medium"
        ],
        "examples": [
          "medium"
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "lookup.customer_number"
  },
  "start": "assign_key",
  "steps": [
    {
      "id": "assign_key",
      "type": "service_task",
      "name": "Assign case reference",
      "handler": "core.business_key",
      "params": {
        "path": "input.customer_number",
        "prefix": "KYR-"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "next": "lookup"
    },
    {
      "id": "lookup",
      "type": "service_task",
      "name": "Find the customer",
      "handler": "customers.lookup",
      "params": {
        "customer_number_path": "input.customer_number"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "review"
    },
    {
      "id": "review",
      "type": "service_task",
      "name": "Open the review",
      "handler": "compliance.open_kyc_review",
      "params": {
        "customer_id_path": "lookup.customer_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "approval"
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approve the outcome",
      "description": "A compliance officer other than the initiator approves the review's outcome.",
      "approval": {
        "permissions": [
          "compliance:monitor"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "complete",
          "when": {
            "path": "approval.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "left_open"
    },
    {
      "id": "complete",
      "type": "service_task",
      "name": "Record the outcome",
      "handler": "compliance.complete_kyc_review",
      "params": {
        "review_id_path": "review.review_id",
        "decided_by_path": "approval.actor_id",
        "risk_rating_path": "input.risk_rating"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "completed"
    },
    {
      "id": "completed",
      "type": "completion",
      "name": "Reviewed",
      "outcome": "approved"
    },
    {
      "id": "left_open",
      "type": "completion",
      "name": "Not approved; review still due",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
