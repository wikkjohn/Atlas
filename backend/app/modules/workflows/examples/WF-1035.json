{
  "workflow_id": "WF-1035",
  "name": "Cost Allocation",
  "version": 1,
  "description": "Finance splits a month's shared operating costs in a currency (rent, technology and the like, recorded against shared costs) across departments by their active headcount. Someone other than the calculator (finance:approve) posts it, moving the costs to the departments' cost centres dated the month's end, or rejects it; the month must be open and the costs unchanged since the split. Stored definition: built only from library handlers (Phase 49).",
  "business_owner": "Finance",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "period",
      "currency"
    ],
    "properties": {
      "period": {
        "type": "string",
        "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
        "examples": [
          "2026-09"
        ]
      },
      "currency": {
        "type": "string",
        "pattern": "^[A-Z]{3}$",
        "examples": [
          "USD"
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "calculate.allocation_number"
  },
  "start": "calculate",
  "steps": [
    {
      "id": "calculate",
      "type": "service_task",
      "name": "Split the shared costs",
      "handler": "finance.calculate_allocation",
      "params": {
        "period_path": "input.period",
        "currency_path": "input.currency"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "approval"
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approve the allocation",
      "description": "Someone other than the calculator reviews the split and posts it.",
      "approval": {
        "permissions": [
          "finance:approve"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "post",
          "when": {
            "path": "approval.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "reject"
    },
    {
      "id": "post",
      "type": "service_task",
      "name": "Post to the cost centres",
      "handler": "finance.post_allocation",
      "params": {
        "allocation_id_path": "calculate.allocation_id",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "done"
    },
    {
      "id": "reject",
      "type": "service_task",
      "name": "Reject the allocation",
      "handler": "finance.reject_allocation",
      "params": {
        "allocation_id_path": "calculate.allocation_id",
        "decided_by_path": "approval.actor_id",
        "note": "Allocation not approved"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "rejected"
    },
    {
      "id": "done",
      "type": "completion",
      "name": "Posted",
      "outcome": "approved"
    },
    {
      "id": "rejected",
      "type": "completion",
      "name": "Rejected",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
