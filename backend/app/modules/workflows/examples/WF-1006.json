{
  "workflow_id": "WF-1006",
  "name": "Debit Card Issue",
  "version": 1,
  "description": "A customer asks for a debit card on their current account. The account must be theirs and open; the card is issued with the product's daily limit in the account's currency. Stored definition: built only from library handlers (Phase 31).",
  "business_owner": "Cards",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "customer_number",
      "account_number"
    ],
    "properties": {
      "customer_number": {
        "type": "string",
        "pattern": "^CUS-[0-9]{7,}$"
      },
      "account_number": {
        "type": "string",
        "minLength": 6,
        "maxLength": 34
      },
      "premium": {
        "type": "boolean",
        "description": "ATLAS Debit Premium instead of ATLAS Debit"
      }
    }
  },
  "presentation": {
    "subject_path": "find_customer.name",
    "risk_path": "find_customer.risk_rating"
  },
  "start": "assign_key",
  "steps": [
    {
      "id": "assign_key",
      "type": "service_task",
      "name": "Assign case reference",
      "handler": "core.business_key",
      "params": {
        "path": "input.account_number",
        "prefix": "CRD-"
      },
      "next": "find_customer"
    },
    {
      "id": "find_customer",
      "type": "service_task",
      "name": "Find the customer",
      "handler": "customers.lookup",
      "params": {
        "customer_number_path": "input.customer_number"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "rejected",
      "next": "find_account"
    },
    {
      "id": "find_account",
      "type": "service_task",
      "name": "Check the account is the customer's",
      "handler": "accounts.lookup",
      "params": {
        "account_number_path": "input.account_number",
        "customer_id_path": "find_customer.customer_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "notify_refused",
      "next": "route_product"
    },
    {
      "id": "route_product",
      "type": "decision",
      "name": "Which card",
      "transitions": [
        {
          "to": "issue_premium",
          "when": {
            "path": "input.premium",
            "op": "truthy"
          }
        }
      ],
      "next": "issue_standard"
    },
    {
      "id": "issue_standard",
      "type": "service_task",
      "name": "Issue ATLAS Debit",
      "handler": "cards.issue",
      "params": {
        "account_number_path": "input.account_number",
        "product_code": "debit-standard"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "notify_refused",
      "next": "notify_standard"
    },
    {
      "id": "issue_premium",
      "type": "service_task",
      "name": "Issue ATLAS Debit Premium",
      "handler": "cards.issue",
      "params": {
        "account_number_path": "input.account_number",
        "product_code": "debit-premium"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "notify_refused",
      "next": "notify_premium"
    },
    {
      "id": "notify_standard",
      "type": "service_task",
      "name": "Tell the customer",
      "handler": "customers.notify",
      "params": {
        "customer_id_path": "find_customer.customer_id",
        "subject": "Your new card",
        "body": "Dear {find_customer.name}, your ATLAS Debit card ending {issue_standard.card_last4} is on its way."
      },
      "next": "issued"
    },
    {
      "id": "notify_premium",
      "type": "service_task",
      "name": "Tell the customer",
      "handler": "customers.notify",
      "params": {
        "customer_id_path": "find_customer.customer_id",
        "subject": "Your new card",
        "body": "Dear {find_customer.name}, your ATLAS Debit Premium card ending {issue_premium.card_last4} is on its way."
      },
      "next": "issued"
    },
    {
      "id": "notify_refused",
      "type": "service_task",
      "name": "Explain why it could not be done",
      "handler": "customers.notify",
      "params": {
        "customer_id_path": "find_customer.customer_id",
        "subject": "Your request",
        "body": "Dear {find_customer.name}, we could not complete your request: {_failure.message}"
      },
      "next": "refused"
    },
    {
      "id": "issued",
      "type": "completion",
      "name": "Card issued",
      "outcome": "issued"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "refused"
    },
    {
      "id": "rejected",
      "type": "completion",
      "name": "Unknown customer",
      "outcome": "rejected"
    }
  ]
}
