{
  "workflow_id": "WF-1005",
  "name": "Statement Copy Request",
  "version": 1,
  "description": "A customer asks for the statement of a month that has ended. The statement is issued if month end has not issued it yet, otherwise the issued one is sent again; either way the figures come from the ledger (Phase 29). Stored definition: built only from library handlers.",
  "business_owner": "Retail Banking Operations",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "customer_number",
      "account_number"
    ],
    "properties": {
      "customer_number": {
        "type": "string",
        "pattern": "^CUS-[0-9]{7,}$"
      },
      "account_number": {
        "type": "string",
        "minLength": 6,
        "maxLength": 34
      },
      "period": {
        "type": "string",
        "pattern": "^20\\d{2}-(0[1-9]|1[0-2])$",
        "examples": [
          "2026-01"
        ],
        "description": "The month (YYYY-MM)"
      }
    }
  },
  "presentation": {
    "subject_path": "find_customer.name",
    "risk_path": "find_customer.risk_rating"
  },
  "start": "assign_key",
  "steps": [
    {
      "id": "assign_key",
      "type": "service_task",
      "name": "Assign case reference",
      "handler": "core.business_key",
      "params": {
        "path": "input.account_number",
        "prefix": "STC-"
      },
      "next": "find_customer"
    },
    {
      "id": "find_customer",
      "type": "service_task",
      "name": "Find the customer",
      "handler": "customers.lookup",
      "params": {
        "customer_number_path": "input.customer_number"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "rejected",
      "next": "find_account"
    },
    {
      "id": "find_account",
      "type": "service_task",
      "name": "Check the account is the customer's",
      "handler": "accounts.lookup",
      "params": {
        "account_number_path": "input.account_number",
        "customer_id_path": "find_customer.customer_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "notify_refused",
      "next": "issue"
    },
    {
      "id": "issue",
      "type": "service_task",
      "name": "Issue or find the statement",
      "handler": "retail.issue_statement",
      "params": {
        "account_number_path": "input.account_number",
        "period_path": "input.period"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "notify_refused",
      "next": "notify_sent"
    },
    {
      "id": "notify_sent",
      "type": "service_task",
      "name": "Send the statement",
      "handler": "customers.notify",
      "params": {
        "customer_id_path": "find_customer.customer_id",
        "subject": "Your statement {issue.statement_number}",
        "body": "Dear {find_customer.name}, statement {issue.statement_number} for account {input.account_number} covers {issue.period_start} to {issue.period_end}: opening balance {issue.opening_balance}, closing balance {issue.closing_balance} (minor units of {issue.currency})."
      },
      "next": "sent"
    },
    {
      "id": "notify_refused",
      "type": "service_task",
      "name": "Explain why it could not be done",
      "handler": "customers.notify",
      "params": {
        "customer_id_path": "find_customer.customer_id",
        "subject": "Your request",
        "body": "Dear {find_customer.name}, we could not complete your request: {_failure.message}"
      },
      "next": "refused"
    },
    {
      "id": "sent",
      "type": "completion",
      "name": "Statement sent",
      "outcome": "sent"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "refused"
    },
    {
      "id": "rejected",
      "type": "completion",
      "name": "Unknown customer",
      "outcome": "rejected"
    }
  ]
}
