{
  "workflow_id": "WF-1048",
  "name": "Invoice Payment",
  "version": 2,
  "description": "Version 2 (Phase 58): before a matched invoice's payment is approved, what the approver weighs is read (procurement.invoice_profile: the amount; the vendor's age, tier and any bank-detail change, and payments since; whether the invoice predates its order; how far it runs over what was received; the vendor's other invoices in 90 days and how many were for the same amount) and the AGB Invoice Review Assistant reviews it; its recommendation is advice only. The invoice may carry the date the vendor put on it. A vendor's invoice is recorded against a received purchase order. It is matched when the total invoiced stays within 2 % of what was received; otherwise it is held for the Procurement page. A matched invoice is paid by someone other than whoever recorded it (procurement:approve), to the vendor's verified bank account, debiting purchases and crediting the bank's cash, or rejected. Stored definition: built only from library handlers (Phase 57).",
  "business_owner": "Procurement",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "order_number",
      "vendor_reference",
      "amount"
    ],
    "properties": {
      "order_number": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "vendor_reference": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9-]+$",
        "examples": [
          "HOS-2026-0412"
        ]
      },
      "amount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000,
        "examples": [
          100000
        ]
      },
      "invoice_date": {
        "type": "string",
        "format": "date",
        "examples": [
          "2041-03-04"
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "record.invoice_number"
  },
  "start": "record",
  "steps": [
    {
      "id": "record",
      "type": "service_task",
      "name": "Record the invoice",
      "handler": "procurement.record_invoice",
      "params": {
        "order_number_path": "input.order_number",
        "vendor_reference_path": "input.vendor_reference",
        "amount_path": "input.amount",
        "invoice_date_path": "input.invoice_date"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "route_matched"
    },
    {
      "id": "route_matched",
      "type": "decision",
      "name": "Matched?",
      "transitions": [
        {
          "to": "profile",
          "when": {
            "path": "record.matched",
            "op": "truthy"
          }
        }
      ],
      "next": "held"
    },
    {
      "id": "profile",
      "type": "service_task",
      "name": "Read the invoice profile",
      "handler": "procurement.invoice_profile",
      "params": {
        "invoice_id_path": "record.invoice_id"
      },
      "next": "ai_review"
    },
    {
      "id": "ai_review",
      "type": "ai_task",
      "name": "AI invoice review (advisory)",
      "handler": "ai.review",
      "params": {
        "tool_id": "agb-invoice-assistant",
        "action": "recommend_decision",
        "payload": {
          "profile": "profile"
        }
      },
      "next": "approval"
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approve the payment",
      "description": "Someone other than whoever recorded the invoice releases the payment.",
      "approval": {
        "permissions": [
          "procurement:approve"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "pay",
          "when": {
            "path": "approval.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "reject"
    },
    {
      "id": "pay",
      "type": "service_task",
      "name": "Pay it",
      "handler": "procurement.pay_invoice",
      "params": {
        "invoice_id_path": "record.invoice_id",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "done"
    },
    {
      "id": "reject",
      "type": "service_task",
      "name": "Reject it",
      "handler": "procurement.reject_invoice",
      "params": {
        "invoice_id_path": "record.invoice_id",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "declined"
    },
    {
      "id": "done",
      "type": "completion",
      "name": "Paid",
      "outcome": "approved"
    },
    {
      "id": "declined",
      "type": "completion",
      "name": "Rejected",
      "outcome": "rejected"
    },
    {
      "id": "held",
      "type": "completion",
      "name": "Held: does not match",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
