# Copy to .env and adjust. Used by Docker Compose and by the backend when run locally.
# All values here are for LOCAL DEVELOPMENT ONLY — never reuse these credentials elsewhere.

# --- PostgreSQL (Docker Compose creates this database and user) ---
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=5432

# --- Backend (read from the environment by backend/app/config.py) ---
ATLAS_ENVIRONMENT=development
ATLAS_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas
# Optional in Phase 1. Leave empty to disable Redis.
ATLAS_REDIS_URL=redis://localhost:6379/0
ATLAS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Access-token signing key. Required (32+ random characters) in staging/production;
# generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ATLAS_JWT_SECRET=
ATLAS_ACCESS_TOKEN_TTL_MINUTES=60
# Password given to the demo users created by `make seed` (local development only).
ATLAS_DEMO_PASSWORD=atlas-demo-password
ATLAS_LOG_LEVEL=INFO
# json (structured) or text (human-readable)
ATLAS_LOG_FORMAT=json
# Background jobs: "inline" (the API runs them) or "worker" (python -m app.cli worker).
ATLAS_JOBS_EXECUTION=inline
# Where archived simulation history is written (shared by the API and every worker).
ATLAS_SIMULATION_ARCHIVE_DIR=var/simulation-archive
# Statements slower than this (ms) go to the slow-query log; 0 turns it off.
ATLAS_SLOW_QUERY_MS=250
# Bearer token for the Prometheus endpoint /api/metrics; leave empty to disable it.
ATLAS_METRICS_TOKEN=

# --- Backend tests (a separate, disposable database; the suite resets its schema) ---
ATLAS_TEST_DATABASE_URL=postgresql+psycopg://atlas:atlas@localhost:5432/atlas_test

# --- Frontend ---
# Where the Vite dev server forwards /api requests.
ATLAS_API_PROXY_TARGET=http://localhost:8000
