{
  "workflow_id": "WF-1040",
  "name": "Payment Plan",
  "version": 2,
  "description": "Version 2 (Phase 54): before the approver decides, what they weigh is read (collections.plan_profile: the arrears and how late they are, the monthly commitment while the plan runs against the money paid into the borrower's account in 90 days and how long since the last of it, the loan's age and the borrower's earlier plans) and the AGB Collections Review Assistant reviews it; its recommendation is advice only. Collections proposes a payment plan for a loan in arrears: one catch-up payment per overdue instalment, a set number of days apart, each settling the oldest overdue instalment from the borrower's account. Someone other than the proposer (loans:approve) activates it or rejects it. While the plan is active the loan cannot be written off; two missed payments break it. Extends WF-0004 Loan Collections. Stored definition: built only from library handlers (Phase 53).",
  "business_owner": "Collections",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "loan_number",
      "interval_days"
    ],
    "properties": {
      "loan_number": {
        "type": "string",
        "pattern": "^LN-[0-9]{7,}$"
      },
      "interval_days": {
        "type": "integer",
        "minimum": 7,
        "maximum": 31,
        "examples": [
          14
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "propose.plan_number"
  },
  "start": "propose",
  "steps": [
    {
      "id": "propose",
      "type": "service_task",
      "name": "Propose the plan",
      "handler": "collections.propose_plan",
      "params": {
        "loan_number_path": "input.loan_number",
        "interval_days_path": "input.interval_days"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "profile"
    },
    {
      "id": "profile",
      "type": "service_task",
      "name": "Read the plan profile",
      "handler": "collections.plan_profile",
      "params": {
        "plan_id_path": "propose.plan_id"
      },
      "next": "ai_review"
    },
    {
      "id": "ai_review",
      "type": "ai_task",
      "name": "AI payment plan review (advisory)",
      "handler": "ai.review",
      "params": {
        "tool_id": "agb-collections-assistant",
        "action": "recommend_decision",
        "payload": {
          "profile": "profile"
        }
      },
      "next": "approval"
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approve the plan",
      "description": "Someone other than the proposer activates the plan.",
      "approval": {
        "permissions": [
          "loans:approve"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "activate",
          "when": {
            "path": "approval.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "reject"
    },
    {
      "id": "activate",
      "type": "service_task",
      "name": "Activate the plan",
      "handler": "collections.approve_plan",
      "params": {
        "plan_id_path": "propose.plan_id",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "active"
    },
    {
      "id": "reject",
      "type": "service_task",
      "name": "Reject the plan",
      "handler": "collections.reject_plan",
      "params": {
        "plan_id_path": "propose.plan_id",
        "decided_by_path": "approval.actor_id",
        "note": "Plan not approved"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "rejected"
    },
    {
      "id": "active",
      "type": "completion",
      "name": "Plan active",
      "outcome": "approved"
    },
    {
      "id": "rejected",
      "type": "completion",
      "name": "Rejected",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
