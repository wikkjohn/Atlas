{
  "template_id": "TPL-PAPER-STATEMENT",
  "version": 1,
  "name": "Paper statement request",
  "description": "WF-1002 as a template: one workflow per country and account product, with the country's currency, its own fee, the permission that approves it, and optional watchlist screening.",
  "id_range": [
    2000,
    2999
  ],
  "parameters": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "country_code",
      "account_type",
      "fee",
      "approval_permission",
      "screen_customers"
    ],
    "properties": {
      "country_code": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      },
      "account_type": {
        "type": "string",
        "enum": [
          "current",
          "savings",
          "business_current"
        ]
      },
      "fee": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000,
        "description": "Whole units of the country's currency"
      },
      "approval_permission": {
        "type": "string",
        "enum": [
          "accounts:manage",
          "accounts:approve"
        ]
      },
      "screen_customers": {
        "type": "boolean"
      }
    }
  },
  "example": {
    "country_code": "GB",
    "account_type": "current",
    "fee": 5,
    "approval_permission": "accounts:manage",
    "screen_customers": true
  },
  "body": {
    "name": "Paper Statements — {{country.name}}, {{account_type}} accounts",
    "description": "Paper statements for {{account_type}} accounts in {{country.name}}: free by e-mail; by post a colleague holding {{approval_permission}} approves a fee of {{fee}} {{country.currency}}, charged before the statements are sent. Generated from TPL-PAPER-STATEMENT.",
    "business_owner": "Retail Banking Operations ({{country.code}})",
    "trigger_type": "api",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "customer_number",
        "account_number",
        "months",
        "delivery"
      ],
      "properties": {
        "customer_number": {
          "type": "string",
          "pattern": "^CUS-[0-9]{7,}$"
        },
        "account_number": {
          "type": "string",
          "minLength": 6,
          "maxLength": 34
        },
        "months": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12,
          "description": "How many months of statements"
        },
        "delivery": {
          "type": "string",
          "enum": [
            "email",
            "post"
          ]
        }
      }
    },
    "presentation": {
      "subject_path": "find_customer.name",
      "risk_path": "find_customer.risk_rating"
    },
    "start": "assign_key",
    "steps": [
      {
        "id": "assign_key",
        "type": "service_task",
        "name": "Assign case reference",
        "handler": "core.business_key",
        "params": {
          "path": "input.account_number",
          "prefix": "STMT-"
        },
        "next": "find_customer"
      },
      {
        "id": "find_customer",
        "type": "service_task",
        "name": "Find the customer",
        "handler": "customers.lookup",
        "params": {
          "customer_number_path": "input.customer_number"
        },
        "retry": {
          "max_attempts": 1,
          "backoff_seconds": 0
        },
        "on_failure": "rejected",
        "next": "find_account"
      },
      {
        "id": "find_account",
        "type": "service_task",
        "name": "Check the account is the customer's",
        "handler": "accounts.lookup",
        "params": {
          "account_number_path": "input.account_number",
          "customer_id_path": "find_customer.customer_id"
        },
        "retry": {
          "max_attempts": 1,
          "backoff_seconds": 0
        },
        "on_failure": "notify_refused",
        "next": "check_product"
      },
      {
        "id": "check_product",
        "type": "service_task",
        "name": "Check the account is a {{account_type}} account in {{country.code}}",
        "handler": "core.check",
        "params": {
          "condition": {
            "all": [
              {
                "path": "find_account.account_type",
                "op": "eq",
                "value": "{{account_type}}"
              },
              {
                "path": "find_customer.country_code",
                "op": "eq",
                "value": "{{country_code}}"
              }
            ]
          },
          "code": "wrong_product",
          "message": "This service is for {{account_type}} accounts of customers in {{country.name}}."
        },
        "retry": {
          "max_attempts": 1,
          "backoff_seconds": 0
        },
        "on_failure": "notify_refused",
        "next": "screen"
      },
      {
        "id": "screen",
        "type": "service_task",
        "name": "Screen the customer's name",
        "$include": "{{screen_customers}}",
        "handler": "compliance.screen_name",
        "params": {
          "name_path": "find_customer.name"
        },
        "next": "screen_route"
      },
      {
        "id": "screen_route",
        "type": "decision",
        "name": "Watchlist match?",
        "$include": "{{screen_customers}}",
        "transitions": [
          {
            "to": "compliance_review",
            "when": {
              "path": "screen.hit",
              "op": "truthy"
            }
          }
        ],
        "next": "route_delivery"
      },
      {
        "id": "compliance_review",
        "type": "approval",
        "name": "Compliance reviews a watchlist match",
        "$include": "{{screen_customers}}",
        "approval": {
          "permissions": [
            "customers:review"
          ],
          "distinct_from": [
            "initiator"
          ]
        },
        "transitions": [
          {
            "to": "route_delivery",
            "when": {
              "path": "compliance_review.approved",
              "op": "truthy"
            }
          }
        ],
        "next": "notify_declined"
      },
      {
        "id": "route_delivery",
        "type": "decision",
        "name": "E-mail or post",
        "transitions": [
          {
            "to": "produce",
            "when": {
              "path": "input.delivery",
              "op": "eq",
              "value": "email"
            }
          }
        ],
        "next": "fee_approval"
      },
      {
        "id": "fee_approval",
        "type": "approval",
        "name": "Approve the paper-statement fee",
        "description": "A colleague confirms the request and the fee (four-eyes).",
        "approval": {
          "permissions": [
            "{{approval_permission}}"
          ],
          "distinct_from": [
            "initiator"
          ]
        },
        "timeout": {
          "after_seconds": 86400,
          "action": "flag"
        },
        "transitions": [
          {
            "to": "charge_fee",
            "when": {
              "path": "fee_approval.approved",
              "op": "truthy"
            }
          }
        ],
        "next": "notify_declined"
      },
      {
        "id": "charge_fee",
        "type": "service_task",
        "name": "Charge the paper-statement fee ({{fee}} {{country.currency}})",
        "handler": "accounts.charge_fee",
        "params": {
          "account_number_path": "input.account_number",
          "amount": "{{fee|minor}}",
          "fee_code": "paper_statement",
          "memo": "Paper statements"
        },
        "retry": {
          "max_attempts": 1,
          "backoff_seconds": 0
        },
        "on_failure": "notify_refused",
        "next": "produce"
      },
      {
        "id": "produce",
        "type": "service_task",
        "name": "Produce the statements",
        "handler": "core.copy_values",
        "params": {
          "fields": {
            "account_number": "input.account_number",
            "months": "input.months",
            "delivery": "input.delivery"
          }
        },
        "next": "notify_sent"
      },
      {
        "id": "notify_sent",
        "type": "service_task",
        "name": "Tell the customer",
        "handler": "customers.notify",
        "params": {
          "customer_id_path": "find_customer.customer_id",
          "subject": "Your statements are on their way",
          "body": "Dear {find_customer.name}, {input.months} months of statements for account {input.account_number} are on their way by {input.delivery}."
        },
        "next": "sent"
      },
      {
        "id": "notify_declined",
        "type": "service_task",
        "name": "Tell the customer it was declined",
        "handler": "customers.notify",
        "params": {
          "customer_id_path": "find_customer.customer_id",
          "subject": "Your statement request",
          "body": "Dear {find_customer.name}, we could not send paper statements. You can request them by e-mail free of charge."
        },
        "next": "declined"
      },
      {
        "id": "notify_refused",
        "type": "service_task",
        "name": "Explain why it could not be done",
        "handler": "customers.notify",
        "params": {
          "customer_id_path": "find_customer.customer_id",
          "subject": "Your statement request",
          "body": "Dear {find_customer.name}, we could not complete your request: {_failure.message}"
        },
        "next": "refused"
      },
      {
        "id": "sent",
        "type": "completion",
        "name": "Statements sent",
        "outcome": "sent"
      },
      {
        "id": "declined",
        "type": "completion",
        "name": "Declined",
        "outcome": "declined"
      },
      {
        "id": "refused",
        "type": "completion",
        "name": "Could not be done",
        "outcome": "refused"
      },
      {
        "id": "rejected",
        "type": "completion",
        "name": "Unknown customer",
        "outcome": "rejected"
      }
    ]
  }
}
