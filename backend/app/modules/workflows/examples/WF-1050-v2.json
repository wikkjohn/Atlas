{
  "workflow_id": "WF-1050",
  "name": "Change Request",
  "version": 2,
  "description": "Version 2 (Phase 60): before a normal change is approved, what the approver weighs is read (itops.change_profile: kind, risk and tier, the backout plan, the window's length, start hour and lead time, business hours and the freeze, the application's open P1 and P2 incidents, and failed changes to the application and by the requester in 90 days) and the AGB Change Review Assistant reviews it; its recommendation is advice only. The window may start at a given hour (UTC). A change to an application is raised for a window some days ahead: risk-rated from its kind, the application's tier and the backout plan. A standard (low-risk) change is pre-approved; a normal or emergency change waits for someone other than the requester (itops:approve), an executive for a high-risk change or a tier-1 application, and never into a window another approved change holds. Tier-1 applications are frozen from the 28th to the 1st. Stored definition: built only from library handlers (Phase 59).",
  "business_owner": "IT Operations",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "application_number",
      "title",
      "kind",
      "backout_plan",
      "days_ahead",
      "hours"
    ],
    "properties": {
      "application_number": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "title": {
        "type": "string",
        "minLength": 5,
        "maxLength": 200,
        "examples": [
          "Upgrade the database driver"
        ]
      },
      "kind": {
        "type": "string",
        "enum": [
          "standard",
          "normal"
        ],
        "examples": [
          "normal"
        ]
      },
      "backout_plan": {
        "type": "string",
        "maxLength": 2000,
        "examples": [
          "Restore the previous release from the artefact store."
        ]
      },
      "days_ahead": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60,
        "examples": [
          3
        ]
      },
      "hours": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12,
        "examples": [
          2
        ]
      },
      "start_hour": {
        "type": "integer",
        "minimum": 0,
        "maximum": 23,
        "examples": [
          22
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "raise.change_number"
  },
  "start": "raise",
  "steps": [
    {
      "id": "raise",
      "type": "service_task",
      "name": "Raise the change",
      "handler": "itops.raise_change",
      "params": {
        "application_number_path": "input.application_number",
        "title_path": "input.title",
        "kind_path": "input.kind",
        "backout_plan_path": "input.backout_plan",
        "days_ahead_path": "input.days_ahead",
        "hours_path": "input.hours",
        "start_hour_path": "input.start_hour"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "route_standard"
    },
    {
      "id": "route_standard",
      "type": "decision",
      "name": "Pre-approved?",
      "transitions": [
        {
          "to": "scheduled",
          "when": {
            "path": "raise.pre_approved",
            "op": "truthy"
          }
        }
      ],
      "next": "profile"
    },
    {
      "id": "profile",
      "type": "service_task",
      "name": "Read the change profile",
      "handler": "itops.change_profile",
      "params": {
        "change_id_path": "raise.change_id"
      },
      "next": "ai_review"
    },
    {
      "id": "ai_review",
      "type": "ai_task",
      "name": "AI change review (advisory)",
      "handler": "ai.review",
      "params": {
        "tool_id": "agb-change-assistant",
        "action": "recommend_decision",
        "payload": {
          "profile": "profile"
        }
      },
      "next": "approval"
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approve the change",
      "description": "Someone other than the requester approves the change (an executive for a high-risk change or a tier-1 application).",
      "approval": {
        "permissions": [
          "itops:approve"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "approve",
          "when": {
            "path": "approval.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "reject"
    },
    {
      "id": "approve",
      "type": "service_task",
      "name": "Approve it",
      "handler": "itops.approve_change",
      "params": {
        "change_id_path": "raise.change_id",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "done"
    },
    {
      "id": "reject",
      "type": "service_task",
      "name": "Reject it",
      "handler": "itops.reject_change",
      "params": {
        "change_id_path": "raise.change_id",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "declined"
    },
    {
      "id": "scheduled",
      "type": "completion",
      "name": "Pre-approved and scheduled",
      "outcome": "approved"
    },
    {
      "id": "done",
      "type": "completion",
      "name": "Approved",
      "outcome": "approved"
    },
    {
      "id": "declined",
      "type": "completion",
      "name": "Rejected",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
