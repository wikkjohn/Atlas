{
  "workflow_id": "WF-1031",
  "name": "Obligor Limit Change",
  "version": 1,
  "description": "A credit officer proposes a new credit limit for a customer, in US dollars. The customer's grade, current limit and exposure are read, and someone other than the proposer (risk:approve) approves the new limit or not. Stored definition: built only from library handlers (Phase 47).",
  "business_owner": "Credit Risk",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "customer_number",
      "limit_usd"
    ],
    "properties": {
      "customer_number": {
        "type": "string",
        "pattern": "^CUS-[0-9]{7,}$"
      },
      "limit_usd": {
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000000,
        "examples": [
          250000
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "lookup.customer_number"
  },
  "start": "assign_key",
  "steps": [
    {
      "id": "assign_key",
      "type": "service_task",
      "name": "Assign case reference",
      "handler": "core.business_key",
      "params": {
        "path": "input.customer_number",
        "prefix": "LIM-"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "next": "lookup"
    },
    {
      "id": "lookup",
      "type": "service_task",
      "name": "Find the customer",
      "handler": "customers.lookup",
      "params": {
        "customer_number_path": "input.customer_number"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "profile"
    },
    {
      "id": "profile",
      "type": "service_task",
      "name": "Read the obligor",
      "handler": "risk.obligor_profile",
      "params": {
        "customer_id_path": "lookup.customer_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "approval"
    },
    {
      "id": "approval",
      "type": "approval",
      "name": "Approve the limit",
      "description": "Someone other than the proposer approves the new limit.",
      "approval": {
        "permissions": [
          "risk:approve"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "set",
          "when": {
            "path": "approval.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "not_set"
    },
    {
      "id": "set",
      "type": "service_task",
      "name": "Set the limit",
      "handler": "risk.set_limit",
      "params": {
        "customer_id_path": "lookup.customer_id",
        "limit_path": "input.limit_usd",
        "decided_by_path": "approval.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "limit_set"
    },
    {
      "id": "limit_set",
      "type": "completion",
      "name": "Limit set",
      "outcome": "approved"
    },
    {
      "id": "not_set",
      "type": "completion",
      "name": "Not approved",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
