{
  "workflow_id": "WF-1038",
  "name": "Complaint Handling",
  "version": 1,
  "description": "A customer's complaint is opened as a case on their account and acknowledged at once (the acknowledgement is due within two days, the final response within eight weeks). The handler proposes redress paid into the account; someone other than the handler (service:approve) approves it, the redress is paid and the complaint resolved as upheld, or refuses it, the redress is withdrawn and the complaint resolved as not upheld. Stored definition: built only from library handlers (Phase 51).",
  "business_owner": "Customer Service",
  "trigger_type": "api",
  "input_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "account_number",
      "channel",
      "topic",
      "subject",
      "description",
      "redress_amount"
    ],
    "properties": {
      "account_number": {
        "type": "string",
        "pattern": "^[A-Z]{2}[0-9A-Z]{8,32}$"
      },
      "channel": {
        "type": "string",
        "enum": [
          "phone",
          "email",
          "chat",
          "branch",
          "letter"
        ],
        "examples": [
          "phone"
        ]
      },
      "topic": {
        "type": "string",
        "enum": [
          "account",
          "card",
          "payments",
          "lending",
          "fees",
          "digital",
          "other"
        ],
        "examples": [
          "card"
        ]
      },
      "subject": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "examples": [
          "Fee charged twice"
        ]
      },
      "description": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000,
        "examples": [
          "The monthly fee was taken twice in October"
        ]
      },
      "redress_amount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000000,
        "examples": [
          1500
        ]
      }
    }
  },
  "presentation": {
    "subject_path": "open.case_number"
  },
  "start": "open",
  "steps": [
    {
      "id": "open",
      "type": "service_task",
      "name": "Open the complaint",
      "handler": "service.open_case",
      "params": {
        "account_number_path": "input.account_number",
        "category": "complaint",
        "channel_path": "input.channel",
        "topic_path": "input.topic",
        "subject_path": "input.subject",
        "description_path": "input.description"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused",
      "next": "acknowledge"
    },
    {
      "id": "acknowledge",
      "type": "service_task",
      "name": "Acknowledge",
      "handler": "service.respond",
      "params": {
        "case_id_path": "open.case_id",
        "message": "We have received your complaint and will send our final response within eight weeks."
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "propose"
    },
    {
      "id": "propose",
      "type": "service_task",
      "name": "Propose redress",
      "handler": "service.propose_redress",
      "params": {
        "case_id_path": "open.case_id",
        "amount_path": "input.redress_amount",
        "account_number_path": "input.account_number"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "decision"
    },
    {
      "id": "decision",
      "type": "approval",
      "name": "Approve the redress",
      "description": "Someone other than the handler approves paying the redress, upholding the complaint.",
      "approval": {
        "permissions": [
          "service:approve"
        ],
        "distinct_from": [
          "initiator"
        ]
      },
      "timeout": {
        "after_seconds": 86400,
        "action": "flag"
      },
      "transitions": [
        {
          "to": "pay",
          "when": {
            "path": "decision.approved",
            "op": "truthy"
          }
        }
      ],
      "next": "withdraw"
    },
    {
      "id": "pay",
      "type": "service_task",
      "name": "Pay the redress",
      "handler": "service.pay_redress",
      "params": {
        "case_id_path": "open.case_id",
        "decided_by_path": "decision.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "uphold"
    },
    {
      "id": "uphold",
      "type": "service_task",
      "name": "Resolve as upheld",
      "handler": "service.resolve",
      "params": {
        "case_id_path": "open.case_id",
        "resolution": "Complaint upheld; redress paid",
        "outcome": "upheld",
        "resolved_by_path": "decision.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "upheld"
    },
    {
      "id": "withdraw",
      "type": "service_task",
      "name": "Withdraw the redress",
      "handler": "service.withdraw_redress",
      "params": {
        "case_id_path": "open.case_id",
        "decided_by_path": "decision.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "not_uphold"
    },
    {
      "id": "not_uphold",
      "type": "service_task",
      "name": "Resolve as not upheld",
      "handler": "service.resolve",
      "params": {
        "case_id_path": "open.case_id",
        "resolution": "Complaint not upheld",
        "outcome": "not_upheld",
        "resolved_by_path": "decision.actor_id"
      },
      "retry": {
        "max_attempts": 1,
        "backoff_seconds": 0
      },
      "on_failure": "refused_after",
      "next": "not_upheld"
    },
    {
      "id": "upheld",
      "type": "completion",
      "name": "Upheld",
      "outcome": "approved"
    },
    {
      "id": "not_upheld",
      "type": "completion",
      "name": "Not upheld",
      "outcome": "rejected"
    },
    {
      "id": "refused",
      "type": "completion",
      "name": "Refused",
      "outcome": "rejected"
    },
    {
      "id": "refused_after",
      "type": "completion",
      "name": "Could not be done",
      "outcome": "rejected"
    }
  ]
}
